{
  "name": "mafitapay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --webpack",
    "dev:webpack": "next dev --webpack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "dev:mobile": "next dev --webpack --hostname 0.0.0.0 --port 3000",
    "mobile:icons": "node scripts/generate-android-branding.mjs",
    "mobile:sync": "node ./node_modules/@capacitor/cli/bin/capacitor sync android",
    "mobile:install": "npm install",
    "mobile:open": "npx cap open android",
    "mobile:open:win": "cmd.exe /c start \"\" \"C:\\Program Files\\Android\\Android Studio\\bin\\studio64.exe\" \"C:\\Users\\zagal\\mafitapay\\android\"",
    "mobile:mirror:win": "rsync -a --delete --exclude node_modules --exclude .next --exclude android/.gradle --exclude android/app/build --exclude android/build ./ /mnt/c/Users/zagal/mafitapay/",
    "mobile:setup:win": "npm run mobile:mirror:win && npm install --prefix /mnt/c/Users/zagal/mafitapay",
    "mobile:run": "MAFITAPAY_MOBILE_SERVER_URL=http://10.0.2.2:3000 npx cap run android",
    "mobile:run:prod": "npx cap run android",
    "mobile:bundle": "cd android && ./gradlew bundleRelease",
    "android:bundle": "cd android && gradlew.bat bundleRelease",
    "db:migrate:postgres": "node scripts/migrate-sqlite-to-postgres.mjs",
    "db:verify:postgres": "node scripts/verify-postgres-migration.mjs"
  },
